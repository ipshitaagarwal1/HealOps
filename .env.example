# --- API keys (never commit .env) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Models: verify current IDs in official docs before use ---
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
GROQ_MODEL=llama-3.3-70b-versatile

# --- Infra ---
DATABASE_URL=postgres://agent:agent@postgres:5432/agent
ADMIN_TOKEN=change-me
AGENT_PORT=3000

# --- Guardrail ---
CONF_RESTART=0.80
CONF_SCALE=0.75
COOLDOWN_MIN=10
MAX_ACTIONS_PER_HOUR=3
NO_CONTEXT_PENALTY=0.15
RAG_MIN_SIMILARITY=0.55
DRY_RUN=false

# --- Timeouts ---
LLM_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=5000
