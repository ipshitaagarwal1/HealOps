# --- API keys (never commit .env) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Models: verify current IDs in official docs before use ---
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
GROQ_MODEL=openai/gpt-oss-120b

# --- Infra ---
DATABASE_URL=postgres://agent:agent@postgres:5432/agent
# Local dev: 16+ characters. Production (docker-compose.prod.yml sets DEPLOY_ENV=
# production): 24+ characters, since the dashboard is then reachable from the internet.
ADMIN_TOKEN=change-me
AGENT_PORT=3000
# Optional: services the agent may act on (allowlist), default shown
ACTION_TARGETS=service-a=http://service-a:8080,service-b=http://service-b:8080
# Optional: where the dashboard's server-side Prometheus proxy queries, default shown
PROMETHEUS_URL=http://prometheus:9090

# --- Production only (docker-compose.prod.yml / Caddyfile) ---
# The public hostname Caddy requests an HTTPS certificate for. Not read anywhere in
# local dev. Point a real domain's A record at the VM's public IP, or - if you don't
# own a domain - use sslip.io, a free service that turns any IP into a working hostname
# with no DNS setup: "<server-ip-with-dots-replaced-by-dashes>.sslip.io", e.g. a VM at
# 203.0.113.10 uses 203-0-113-10.sslip.io. It resolves to that IP automatically, and
# Let's Encrypt will issue it a real certificate like any other domain.
DOMAIN=

# --- Guardrail ---
CONF_RESTART=0.80
CONF_SCALE=0.75
COOLDOWN_MIN=10
MAX_ACTIONS_PER_HOUR=3
NO_CONTEXT_PENALTY=0.15
RAG_MIN_SIMILARITY=0.72
DRY_RUN=false

# --- Timeouts ---
LLM_TIMEOUT_MS=10000
# Optional, default 5000
EMBED_TIMEOUT_MS=5000
ACTION_TIMEOUT_MS=5000
